# Copy to .env.local and fill in. Never commit real values.

# Supabase (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret, server-side only
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=

# AI model for scanning (OpenAI, server-side only)
# secret
OPENAI_API_KEY=
# model name, e.g. from https://platform.openai.com/docs/models (must support images)
LLM_MODEL=
# price in USD per 1M tokens, only used for the cost statistics (public)
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
# scans per user per day (default 30)
SCAN_DAILY_LIMIT=

# OCR service (ocr-service/, runs on Hugging Face Spaces)
# public: address of the service, e.g. https://<user>-wtfood-ocr.hf.space
OCR_URL=
# secret: same value as the Space secret OCR_API_KEY
OCR_API_KEY=
# items read with lower confidence get "Check" (default 0.7)
OCR_MIN_CONFIDENCE=

# DeepL API Free for A1 translation (secret, ends with :fx)
DEEPL_API_KEY=
