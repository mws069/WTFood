# Copy to .env.local and fill in. Never commit real values.

# Supabase (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# secret, server-side only
SUPABASE_SECRET_KEY=

# App
NEXT_PUBLIC_SITE_URL=

# AI model for scanning (OpenAI, server-side only)
# secret
OPENAI_API_KEY=
# model name, e.g. from https://platform.openai.com/docs/models (must support images)
LLM_MODEL=
# price in USD per 1M tokens, only used for the cost statistics (public)
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
# scans per user per day (default 30)
SCAN_DAILY_LIMIT=

# OCR service (ocr-service/, runs on Google Cloud Run)
# public: address of the service, e.g. https://wtfood-ocr-….run.app
OCR_URL=
# secret: same value as OCR_API_KEY on the Cloud Run service
OCR_API_KEY=
# items read with lower confidence get "Check" (default 0.7)
OCR_MIN_CONFIDENCE=

# A3: minimum character-bigram similarity for a dish to count as the same dish (default 0.75)
A3_MIN_SIMILARITY=

# Ask-staff translator (OpenAI, same key)
# public: model for translations, e.g. gpt-6-luna (fast and cheap; default: LLM_MODEL)
TRANSLATE_MODEL=
# public: speech-to-text model (default gpt-transcribe)
TRANSCRIBE_MODEL=
# translations per user per day (default 100)
TRANSLATE_DAILY_LIMIT=

# DeepL API Free for A1 translation (secret, ends with :fx)
DEEPL_API_KEY=
